# Copy to.env (git-ignored) and adjust.

# Postgres superuser password.
POSTGRES_PASSWORD=postgres

# Must use the same password as above.
PG_DSN=postgresql://postgres:postgres@127.0.0.1:5432/hansard

# The local GPU service (cd gpu; uv run python api.py): query embedding and reranking for the search.

# LLM providers (Phase 3).
DEEPSEEK_KEY=
GROQ_KEY=

# Model names and endpoint; the defaults live in src/app/config.py.

# Hugging Face access token.
HF_TOKEN=
